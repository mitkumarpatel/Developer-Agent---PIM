{
  "name": "pim-product-sync",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@adobe/aio-commerce-lib-app": "^1.11.0",
    "@adobe/aio-commerce-lib-config": "1.7.0",
    "@adobe/aio-commerce-sdk": "^1.4.2",
    "@ljharb/tsconfig": "^0.2.3",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@tsconfig/bases": "^1.0.28"
  },
  "description": "Syncs product data (SKU, name, description, price, stock, attributes) from an external PIM to Adobe Commerce via inbound webhook.",
  "scripts": {
    "typecheck:actions": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:actions",
    "postinstall": "npx aio-commerce-lib-app hooks postinstall"
  },
  "imports": {
    "#app.commerce.config": "./src/commerce-extensibility-1/.generated/app.commerce.config.js"
  }
